PORT=3000
NODE_ENV=production

# Aurora MySQL: writes/schema/session DB use writer, read-only SELECTs use reader.
DB_WRITER_HOST=database-1.cluster-cp6kgueq0eik.ap-northeast-2.rds.amazonaws.com
DB_READER_HOST=database-1.cluster-ro-cp6kgueq0eik.ap-northeast-2.rds.amazonaws.com
DB_PORT=3306
DB_USER=plum
DB_PASSWORD=change-me
DB_NAME=plumcommerce
DB_SSL=true
# Run schema migration once as a deployment step, not concurrently on every ASG instance.
AUTO_MIGRATE_SCHEMA=false

# S3 upload target. EC2 should receive access through an instance profile, not static keys.
AWS_REGION=ap-northeast-2
S3_BUCKET=sm-plum-615299743460-ap-northeast-2-an
S3_BUCKET_ARN=arn:aws:s3:::sm-plum-615299743460-ap-northeast-2-an
S3_ORIGIN_PREFIX=image/origin
S3_THUMBNAIL_PREFIX=image/thumbnail
# Prefer a CloudFront domain here. The default S3 URL requires objects to be browser-readable.
IMAGE_BASE_URL=https://sm-plum-615299743460-ap-northeast-2-an.s3.ap-northeast-2.amazonaws.com
MAX_IMAGE_SIZE_BYTES=10485760
IMAGE_DIR=./public/image

# ElastiCache for Valkey node endpoints. Session writes use the 2a primary node only.
# The 2c replica endpoint is recorded for operations/monitoring and is not used for writes.
SESSION_BACKEND=valkey
SESSION_SECRET=change-me-to-a-long-random-value
VALKEY_PRIMARY_ENDPOINT=cache-0001-001.cache.kjbeur.apn2.cache.amazonaws.com:6379
VALKEY_REPLICA_ENDPOINT=cache-0001-002.cache.kjbeur.apn2.cache.amazonaws.com:6379
VALKEY_TLS=true
# Optional full URL override (for example, when embedding an auth token):
# VALKEY_URL=rediss://:<auth-token>@cache-0001-001.cache.kjbeur.apn2.cache.amazonaws.com:6379
VALKEY_PREFIX=plum:sess:
SESSION_DB_TABLE=sessions

PAYMENT_BASE_URL=https://mock-payments.internal.local
PAYMENT_TIMEOUT_MS=1500
ALLOWLISTED_EGRESS_IP=203.0.113.10
