<%- include('partials/header') %>
<h2>Cart</h2>
<% 
let totalPrice = 0; 
%>

<ul>
  <% items.forEach(i => { %>
    <% 
    let priceNum = Number(i.price) || 0; 
    totalPrice += priceNum; 
    %>
    <li><%= i.name %> - ₩<%= priceNum.toLocaleString('ko-KR') %></li>
  <% }) %>
</ul>

<p>Total: ₩<%= totalPrice.toLocaleString('ko-KR') %></p>

<form method="post" action="/checkout"><button>Mock Checkout</button></form>
<% if (charge) { %><pre><%= JSON.stringify(charge,null,2) %></pre><% } %>
<%- include('partials/footer') %>