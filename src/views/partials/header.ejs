<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Plum Commerce</title>
  <link rel="stylesheet" href="/styles/site.css">
</head>
<body>
<header class="site-header">
  <nav class="top-nav" aria-label="Primary navigation">
    <a href="/products">Products</a>
    <a href="/flash-sale">Flash Sale</a>
    <a href="/cart">Cart</a>
    <% if (typeof currentAdmin !== 'undefined' && currentAdmin) { %>
      <a href="/admin">Admin Dashboard</a>
    <% } %>
  </nav>
  <a class="brand" href="/products" aria-label="Plum Commerce home">
    <img src="/assets/plum-logo.svg" alt="Plum Commerce logo">
    <span>Plum Commerce</span>
  </a>
  <div class="auth-links">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %>
      <span>Hi, <%= currentUser.username %></span>
      <form method="post" action="/logout"><button type="submit" class="link-button">Logout</button></form>
    <% } else { %>
      <a href="/login">Login</a>
      <a href="/signup">Sign Up</a>
    <% } %>
  </div>
</header>
<main class="page-shell">
