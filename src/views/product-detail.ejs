<%- include('partials/header') %>
<section class="detail-layout">
  <div class="detail-image"><img src="<%= imageUrl(product.image) %>" alt="<%= product.name %>"/></div>
  <div>
    <span class="pill"><%= product.category %></span>
    <h1><%= product.name %></h1>
    <p><%= product.description %></p>
    <p class="price">₩<%= Number(product.price).toLocaleString('ko-KR') %></p>
    <form method="post" action="/cart/add/<%= product.id %>"><button>Add to Cart</button></form>
  </div>
</section>
<%- include('partials/footer') %>
